APP_URL=http://localhost:3000
PORT=3000
SECRET=app_secret_for_encryption

DATABASE_URL=postgres://postgres:postgres@localhost:5432/volvecapital
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/volvecapital
TENANT_SCHEMAS=papapremium

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# DOKU Config
DOKU_CLIENT_ID=G-XXXXXXXXXXXX
DOKU_SECRET_KEY=SK-XXXXXXXXXXXX
DOKU_IS_PRODUCTION=false
DOKU_NOTIFY_URL=https://your-ngrok.ngrok-free.app/public/payment/notify

# WhatsApp Business API (Meta)
# Dapatkan token dari: Facebook Developer Console → WhatsApp → API Setup → Generate Token
# Untuk production: gunakan System User token (tidak expire)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v20.0
# Nama template yang sudah approved di Meta Business Suite
WHATSAPP_TEMPLATE_NAME=voucher_kode_pembayaran
WHATSAPP_TEMPLATE_LANGUAGE=id
# Untuk sandbox testing, gunakan hello_world / en_US
# WHATSAPP_TEMPLATE_NAME=hello_world
# WHATSAPP_TEMPLATE_LANGUAGE=en_US

